  "description": "A customizable in-stage developer console overlay for TurboWarp with command registration and autocomplete",
  "main": "developer-console.js",
  "scripts": {
    "test": "node -c developer-console.js",
    "check": "node -c developer-console.js && echo 'Syntax check passed!'"
