  "turbowarp": {
    "extension": {
      "id": "developerConsole",
      "name": "Developer Console",
      "description": "Provides a customizable in-stage developer console overlay",
      "unsandboxed": true,
      "features": [
        "Console toggle with ~ key",
        "Command registration system",
